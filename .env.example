# Database PostgreSQL
DATABASE_URL=postgresql+psycopg://loe:loe_dev@localhost:5433/project_loe5
AUTH_SECRET=lukla_operations_engine_super_secret_auth_key_2026_dev_secure
ENVIRONMENT=development

# Microservices Port Configuration
AUTH_SERVICE_PORT=8001
MANUFACTURING_SERVICE_PORT=8002
FINANCE_SERVICE_PORT=8003
AI_AGENT_SERVICE_PORT=8004

# AI Agent Service (Gemini RAG + Tool Calling)
