# 1. Environment Variables, Secrets & Credentials
# Abaikan seluruh file .env (dan variasinya), kecualikan .env.example
.env*
!.env.example
**/.env*
!**/.env.example
*.env.local
**/*.env.local

# Cache indeks RAG lokal (dibangun ulang otomatis)
.rag_index.json
**/.rag_index.json

# Certificates, Keys & Cloud Credentials
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# 2. Python & Virtual Environments (Monorepo & Microservices)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
*.egg-info/
**/*.egg-info/
dist/
build/
.eggs/
*.egg

# Testing & Linting Caches (Python)
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

