# 1. Environment Variables, Secrets & Credentials
# Abaikan seluruh file .env (dan variasinya), kecualikan .env.example
.env*
!.env.example
**/.env*
!**/.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# 2. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
*.egg

# Testing & Linting Caches (Python)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# 3. Node.js & Frontend (Next.js)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.turbo/
.vercel/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

