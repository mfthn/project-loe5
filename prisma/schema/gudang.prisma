// Modul Gudang Multi-Klien dan Anti-Kontaminasi Silang (FR-5, FR-6)

enum StockType {
  RAW
  WIP
  FINISHED
}

enum MovementDirection {
  IN
  OUT
}

// Satu baris = satu lot bahan milik satu klien untuk satu pesanan.
// quantity adalah cache saldo yang dijaga trigger dari stock_movements.
model StockItem {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(30)
  name        String          @db.VarChar(150)
  type        StockType
  clientId    String          @map("client_id")
  client      Client          @relation(fields: [clientId], references: [id])
  orderId     String          @map("order_id")
  order       ProductionOrder @relation(fields: [orderId], references: [id])
  quantity    Decimal         @default(0) @db.Decimal(12, 3)
  unit        String          @db.VarChar(20)
  receivedAt  DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  createdById String          @map("created_by")
  createdBy   User            @relation(fields: [createdById], references: [id])

  movements StockMovement[]

  @@index([clientId])
  @@index([orderId])
  @@map("stock_items")
}

// Pergerakan stok, append-only.
model StockMovement {
  id          BigInt            @id @default(autoincrement())
  itemId      String            @map("item_id")
  item        StockItem         @relation(fields: [itemId], references: [id])
  direction   MovementDirection
  quantity    Decimal           @db.Decimal(12, 3)
  orderId     String            @map("order_id")
  order       ProductionOrder   @relation(fields: [orderId], references: [id])
  note        String?           @db.VarChar(255)
  createdById String            @map("created_by")
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, createdAt])
  @@map("stock_movements")
}
