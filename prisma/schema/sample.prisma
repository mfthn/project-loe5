// Modul Sample dan Time Study (FR-1 s.d. FR-4)

enum SampleVersionStatus {
  DRAFT
  APPROVED
  CONVERTED
}

model Sample {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(150)
  clientId    String?  @map("client_id")
  client      Client?  @relation(fields: [clientId], references: [id])
  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  versions SampleVersion[]

  @@map("samples")
}

// Setiap revisi membentuk versi baru yang terhubung ke versi sebelumnya lewat parentId.
model SampleVersion {
  id            String              @id @default(cuid())
  sampleId      String              @map("sample_id")
  sample        Sample              @relation(fields: [sampleId], references: [id])
  versionNumber Int                 @map("version_number")
  parentId      String?             @map("parent_id")
  parent        SampleVersion?      @relation("VersionChain", fields: [parentId], references: [id])
  children      SampleVersion[]     @relation("VersionChain")
  specJson      Json                @map("spec_json")
  status        SampleVersionStatus @default(DRAFT)
  approvedById  String?             @map("approved_by")
  approvedBy    User?               @relation("VersionApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(6)
  createdById   String              @map("created_by")
  createdBy     User                @relation("VersionCreator", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  orders       ProductionOrder[]
  timeStudies  TimeStudy[]
  materialUses SampleMaterialUse[]

  @@unique([sampleId, versionNumber])
  @@map("sample_versions")
}

model TimeStudy {
  id              String        @id @default(cuid())
  sampleVersionId String        @map("sample_version_id")
  sampleVersion   SampleVersion @relation(fields: [sampleVersionId], references: [id])
  componentName   String        @map("component_name") @db.VarChar(120)
  seconds         Decimal       @db.Decimal(10, 2)
  recordedById    String        @map("recorded_by")
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  recordedAt      DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("time_studies")
}

model SampleMaterialUse {
  id              String        @id @default(cuid())
  sampleVersionId String        @map("sample_version_id")
  sampleVersion   SampleVersion @relation(fields: [sampleVersionId], references: [id])
  materialName    String        @map("material_name") @db.VarChar(150)
  quantity        Decimal       @db.Decimal(12, 3)
  unit            String        @db.VarChar(20)
  recordedById    String        @map("recorded_by")
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  recordedAt      DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("sample_material_uses")
}
